df_test  = df.iloc[split_idx:].copy()   # 2017-2026 (107)

def add_rollings_precenso(d):
    d["prcp_roll3"]  = d["log_prcp"].rolling(3).mean()
    d["prcp_roll6"]  = d["log_prcp"].rolling(6).mean()
    d["prcp_roll12"] = d["log_prcp"].rolling(12).mean()

    d["prcp_std6"]   = d["log_prcp"].rolling(6).std()
    d["prcp_std12"]  = d["log_prcp"].rolling(12).std()

    d["prcp_max12"]  = d["log_prcp"].rolling(12).max()
    d["prcp_min12"]  = d["log_prcp"].rolling(12).min()

    d["enso_roll3"]  = d["ANOM"].rolling(3).mean()
    d["enso_roll6"]  = d["ANOM"].rolling(6).mean()

def add_rollings_pres(d):
    d["pres_roll3"]  = d["pres"].rolling(3).mean()
    d["pres_roll6"]  = d["pres"].rolling(6).mean()
    d["pres_roll12"] = d["pres"].rolling(12).mean()

    d["pres_std6"]   = d["pres"].rolling(6).std()
    d["pres_std12"]  = d["pres"].rolling(12).std()

    d["pres_min12"]  = d["pres"].rolling(12).min()
    d["pres_max12"]  = d["pres"].rolling(12).max()

add_rollings_precenso(df_train)
add_rollings_precenso(df_test)

