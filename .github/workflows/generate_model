name: Generate ML Model

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  run-test:
    runs-on: ubuntu-latest

    strategy:
      max-parallel: 1
      matrix:
        station: ["84370", "84401", "84501"]

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: "3.10"

      - name: Install dependencies
        run: |
          pip install -r requirements.txt

      - name: Run model script (forecast + test)
        env:
          STATION_ID: ${{ matrix.station }}
        run: |
          python scripts/generate_test.py

      - name: Upload forecast artifact
        uses: actions/upload-artifact@v3
        with:
          name: pred_${{ matrix.station }}
          path: data/pred_${{ matrix.station }}.csv

      - name: Upload test artifact
        uses: actions/upload-artifact@v3
        with:
          name: test_${{ matrix.station }}
          path: data/test_${{ matrix.station }}.csv
